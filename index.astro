---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
---
<Layout title="Simon Plourde">
  <div class="container">

    <section class="hero">
      <div class="hero-avatar-placeholder">👤</div>
      <h1>Simon Plourde</h1>
      <p class="hero-bio">
        [Your one-liner here — what you do, what you care about.]
      </p>

      <div class="card-grid">
        <a href="/blog" class="card">
          <span class="card-emoji">✍️</span>
          <div class="card-text">
            <div class="card-title">Blog</div>
            <div class="card-desc">Thoughts & writing</div>
          </div>
        </a>
        <a href="/about" class="card">
          <span class="card-emoji">👤</span>
          <div class="card-text">
            <div class="card-title">About</div>
            <div class="card-desc">Background & resume</div>
          </div>
        </a>
        <a href="mailto:simonplourde.pro@gmail.com" class="card">
          <span class="card-emoji">📬</span>
          <div class="card-text">
            <div class="card-title">Contact</div>
            <div class="card-desc">Get in touch</div>
          </div>
        </a>
        <a href="https://github.com/simon-plourde" target="_blank" class="card">
          <span class="card-emoji">💻</span>
          <div class="card-text">
            <div class="card-title">GitHub</div>
            <div class="card-desc">Code & projects</div>
          </div>
        </a>
      </div>
    </section>

    {posts.length > 0 && (
      <section>
        <p class="section-label">Recent Posts</p>
        <ul class="post-list">
          {posts.map(post => (
            <li class="post-item">
              <a href={`/blog/${post.slug}`}>{post.data.title}</a>
              <span class="post-date">{formatDate(post.data.pubDate)}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

  </div>
</Layout>
