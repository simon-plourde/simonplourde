---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'fr';
}
const {
  title,
  description = "Personal website of Simon Plourde — writing and resume.",
  lang = 'en',
} = Astro.props;

const currentPath = Astro.url.pathname;

// Compute alternate language URL
let altHref: string;
if (lang === 'fr') {
  const stripped = currentPath.slice(3);
  altHref = stripped || '/';
} else {
  altHref = currentPath === '/' ? '/fr/' : `/fr${currentPath}`;
}

const nav = {
  en: { home: 'Home', blog: 'Blog', about: 'About' },
  fr: { home: 'Accueil', blog: 'Blog', about: 'À propos' },
}[lang];

const footer = {
  en: { resume: 'Resume' },
  fr: { resume: 'CV' },
}[lang];
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="alternate" hreflang="en" href={lang === 'fr' ? altHref : currentPath} />
  <link rel="alternate" hreflang="fr" href={lang === 'en' ? altHref : currentPath} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script is:inline>
    // Apply saved theme before paint to avoid flash
    (function() {
      const saved = localStorage.getItem('theme');
      if (saved) document.documentElement.setAttribute('data-theme', saved);
    })();
  </script>
</head>
<body>

  <!-- Full-viewport overlay for sunset/sunrise transition -->
  <div id="theme-overlay" aria-hidden="true"></div>

  <nav>
    <div class="inner">
      <a href={lang === 'fr' ? '/fr/' : '/'} class="nav-logo">Simon Plourde</a>
      <div class="nav-right">
        <ul class="nav-links">
          <li><a href={lang === 'fr' ? '/fr/' : '/'} aria-current={currentPath === '/' || currentPath === '/fr/' ? 'page' : undefined}>{nav.home}</a></li>
          <li><a href={lang === 'fr' ? '/fr/blog' : '/blog'} aria-current={currentPath.includes('/blog') ? 'page' : undefined}>{nav.blog}</a></li>
          <li><a href={lang === 'fr' ? '/fr/about' : '/about'} aria-current={currentPath.includes('/about') ? 'page' : undefined}>{nav.about}</a></li>
        </ul>
        <div class="lang-switcher">
          {lang === 'en'
            ? <><span class="lang-active">EN</span><span class="lang-sep">|</span><a href={altHref}>FR</a></>
            : <><a href={altHref}>EN</a><span class="lang-sep">|</span><span class="lang-active">FR</span></>
          }
        </div>
        <!-- Slider toggle: moon on left = dark, sun on right = light -->
        <button
          class="theme-toggle"
          id="theme-toggle"
          role="switch"
          aria-checked="false"
          aria-label="Toggle dark mode"
          title="Toggle dark / light mode"
        >
          <span class="toggle-track">
            <span class="toggle-icon moon-icon">☽</span>
            <span class="toggle-thumb"></span>
            <span class="toggle-icon sun-icon">☀</span>
          </span>
        </button>
      </div>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer>
    <div class="inner">
      <span class="footer-left">© {new Date().getFullYear()} Simon Plourde</span>
      <ul class="footer-links">
        <li><a href="https://github.com/simon-plourde" target="_blank" rel="noopener">GitHub</a></li>
        <li><a href={lang === 'fr' ? '/fr/about' : '/about'}>{footer.resume}</a></li>
        <li><a href={lang === 'fr' ? '/fr/blog' : '/blog'}>{nav.blog}</a></li>
      </ul>
    </div>
  </footer>

  <script is:inline>
    const btn = document.getElementById('theme-toggle');
    const overlay = document.getElementById('theme-overlay');
    let transitioning = false;
    let currentTheme;

    function getEffectiveTheme() {
      const saved = localStorage.getItem('theme');
      if (saved) return saved;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function applyTheme(theme, animate) {
      currentTheme = theme;

      if (animate && !transitioning) {
        transitioning = true;
        // Start the sky animation immediately
        overlay.className = theme === 'dark' ? 'sunset' : 'sunrise';

        // Switch the actual theme at the peak of the overlay (≈48% into 1.1s)
        setTimeout(function() {
          document.documentElement.setAttribute('data-theme', theme);
          btn.setAttribute('aria-checked', theme === 'dark' ? 'true' : 'false');
          localStorage.setItem('theme', theme);
        }, 520);

        // Clear overlay and unlock after animation finishes
        setTimeout(function() {
          overlay.className = '';
          transitioning = false;
        }, 1150);

      } else {
        document.documentElement.setAttribute('data-theme', theme);
        btn.setAttribute('aria-checked', theme === 'dark' ? 'true' : 'false');
        localStorage.setItem('theme', theme);
      }
    }

    // Init without animation (no flash)
    applyTheme(getEffectiveTheme(), false);

    btn.addEventListener('click', function() {
      if (transitioning) return;
      applyTheme(currentTheme === 'dark' ? 'light' : 'dark', true);
    });
  </script>

</body>
</html>
