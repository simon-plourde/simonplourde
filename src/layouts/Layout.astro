---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'fr';
}
const {
  title,
  description = "Simon Plourde — IT Professional & Tech Blog, Montréal",
  lang = 'en',
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site);

let altHref: string;
if (lang === 'fr') {
  const stripped = currentPath.slice(3);
  altHref = stripped || '/';
} else {
  altHref = currentPath === '/' ? '/fr/' : `/fr${currentPath}`;
}

const nav = {
  en: { home: 'Home', blog: 'Blog', about: 'About' },
  fr: { home: 'Accueil', blog: 'Blog', about: 'À propos' },
}[lang];

const footer = {
  en: { resume: 'Resume' },
  fr: { resume: 'CV' },
}[lang];
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://simonplourde.com/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={lang === 'fr' ? 'fr_CA' : 'en_CA'} />
  <meta property="og:site_name" content="Simon Plourde" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://simonplourde.com/og-image.png" />

  <!-- Hreflang -->
  <link rel="alternate" hreflang="en" href={lang === 'fr' ? new URL(altHref, Astro.site) : canonicalURL} />
  <link rel="alternate" hreflang="fr" href={lang === 'en' ? new URL(altHref, Astro.site) : canonicalURL} />
  <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />

  <!-- RSS -->
  <link rel="alternate" type="application/rss+xml" title="Simon Plourde" href={lang === 'fr' ? '/fr/rss.xml' : '/rss.xml'} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Page-specific head (e.g. JSON-LD) -->
  <slot name="head" />

  <script is:inline>
    (function() {
      const saved = localStorage.getItem('theme');
      if (saved) document.documentElement.setAttribute('data-theme', saved);
    })();
  </script>
</head>
<body>

  <nav>
    <div class="inner">
      <a href={lang === 'fr' ? '/fr/' : '/'} class="nav-logo">Simon Plourde</a>
      <div class="nav-right">
        <ul class="nav-links">
          <li><a href={lang === 'fr' ? '/fr/' : '/'} aria-current={currentPath === '/' || currentPath === '/fr/' ? 'page' : undefined}>{nav.home}</a></li>
          <li><a href={lang === 'fr' ? '/fr/blog' : '/blog'} aria-current={currentPath.includes('/blog') ? 'page' : undefined}>{nav.blog}</a></li>
          <li><a href={lang === 'fr' ? '/fr/about' : '/about'} aria-current={currentPath.includes('/about') ? 'page' : undefined}>{nav.about}</a></li>
        </ul>
        <div class="lang-switcher">
          {lang === 'en'
            ? <><span class="lang-active">EN</span><span class="lang-sep">|</span><a href={altHref}>FR</a></>
            : <><a href={altHref}>EN</a><span class="lang-sep">|</span><span class="lang-active">FR</span></>
          }
        </div>
        <button class="theme-toggle" id="theme-toggle" role="switch" aria-checked="false" aria-label="Toggle dark mode">
          <span class="toggle-track">
            <span class="toggle-thumb"></span>
          </span>
        </button>
      </div>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer>
    <div class="inner">
      <span class="footer-left">© {new Date().getFullYear()} Simon Plourde</span>
    </div>
  </footer>

  <script is:inline>
    const btn = document.getElementById('theme-toggle');
    let currentTheme;

    function getEffectiveTheme() {
      const saved = localStorage.getItem('theme');
      if (saved) return saved;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function applyTheme(theme) {
      currentTheme = theme;
      document.documentElement.setAttribute('data-theme', theme);
      btn.setAttribute('aria-checked', theme === 'dark' ? 'true' : 'false');
      localStorage.setItem('theme', theme);
    }

    applyTheme(getEffectiveTheme());

    btn.addEventListener('click', function() {
      applyTheme(currentTheme === 'dark' ? 'light' : 'dark');
    });
  </script>

</body>
</html>
