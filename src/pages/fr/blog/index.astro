---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog-fr'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('fr-CA', { month: 'long', day: 'numeric', year: 'numeric' });
}
---
<Layout title="Blogue — Simon Plourde" description="Articles de Simon Plourde." lang="fr">
  <div class="container">

    <section class="page-hero">
      <h1>Blogue</h1>
      <p>Réflexions, idées et choses apprises.</p>
    </section>

    <ul class="post-full-list">
      {posts.map(post => (
        <li class="post-full-item">
          <div class="post-full-meta">
            <span class="post-full-date">{formatDate(post.data.pubDate)}</span>
            {post.data.tags?.[0] && <span class="post-tag">{post.data.tags[0]}</span>}
          </div>
          <h2><a href={`/fr/blog/${post.slug}`}>{post.data.title}</a></h2>
          <p class="post-excerpt">{post.data.description}</p>
        </li>
      ))}
    </ul>

  </div>
</Layout>
