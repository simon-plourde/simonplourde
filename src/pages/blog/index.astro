---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
---
<Layout title="Blog — Simon Plourde" description="Writing by Simon Plourde.">
  <div class="container">

    <section class="page-header">
      <h1>Blog</h1>
      <p>Thoughts, ideas, and things I've learned.</p>
    </section>

    <section class="section">
      <ul class="post-list post-list-full">
        {posts.map(post => (
          <li class="post-item">
            <div class="post-meta">
              <span class="post-date">{formatDate(post.data.pubDate)}</span>
              {post.data.tags?.[0] && <span class="post-tag">{post.data.tags[0]}</span>}
            </div>
            <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            <p class="post-excerpt">{post.data.description}</p>
          </li>
        ))}
      </ul>
    </section>

  </div>
</Layout>
