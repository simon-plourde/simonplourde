---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---
<Layout title="Blog — Simon Plourde" description="Writing by Simon Plourde.">
  <div class="container">

    <section class="page-hero">
      <h1>Blog</h1>
      <p>Thoughts, ideas, and things I've learned.</p>
    </section>

    <ul class="post-full-list">
      {posts.map(post => (
        <li class="post-full-item">
          <div class="post-full-meta">
            <span class="post-full-date">{formatDate(post.data.pubDate)}</span>
            {post.data.tags?.[0] && <span class="post-tag">{post.data.tags[0]}</span>}
          </div>
          <h2><a href={`/blog/${post.slug}`}>{post.data.title}</a></h2>
          <p class="post-excerpt">{post.data.description}</p>
        </li>
      ))}
    </ul>

  </div>
</Layout>
