---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About — Simon Plourde">
  <div class="container">

    <section class="about-hero">
      <h1>About Me</h1>
      <p>Hi, I'm Simon — [your short bio here: what you do, where you're based, what you're interested in].</p>
      <p>[Add a second paragraph — what you're working on, what drives you, etc.]</p>
      <div class="contact-links">
        <a href="mailto:simonplourde.pro@gmail.com" class="btn btn-dark">Get in touch</a>
        <a href="https://github.com/simon-plourde" class="btn btn-outline" target="_blank">GitHub</a>
      </div>
    </section>

    <section class="resume-block">
      <p class="resume-block-label">Experience</p>
      <div class="resume-item">
        <div class="resume-row"><span class="resume-title">Job Title</span><span class="resume-date">2023 – Present</span></div>
        <div class="resume-org">Company Name</div>
        <div class="resume-desc">Brief description of what you did and what impact you had.</div>
      </div>
      <div class="resume-item">
        <div class="resume-row"><span class="resume-title">Previous Job Title</span><span class="resume-date">2020 – 2023</span></div>
        <div class="resume-org">Previous Company</div>
        <div class="resume-desc">Brief description of responsibilities and achievements.</div>
      </div>
    </section>

    <section class="resume-block">
      <p class="resume-block-label">Education</p>
      <div class="resume-item">
        <div class="resume-row"><span class="resume-title">Degree / Program</span><span class="resume-date">2016 – 2020</span></div>
        <div class="resume-org">University / School Name</div>
      </div>
    </section>

    <section class="resume-block">
      <p class="resume-block-label">Skills</p>
      <div class="skills-grid">
        <span class="skill-tag">Skill 1</span>
        <span class="skill-tag">Skill 2</span>
        <span class="skill-tag">Skill 3</span>
        <span class="skill-tag">Skill 4</span>
        <span class="skill-tag">Skill 5</span>
      </div>
    </section>

  </div>
</Layout>
