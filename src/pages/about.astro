---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About — Simon Plourde" description="About Simon Plourde — background, experience, and resume.">
  <div class="container">

    <section class="about-intro">
      <h1>About Me</h1>
      <p>
        Hi, I'm Simon — [your short bio here: what you do, where you're based, what you're interested in].
      </p>
      <p>
        [Add a second paragraph if you want — what you're working on, what drives you, etc.]
      </p>
      <div class="hero-links" style="margin-top: 24px;">
        <a href="mailto:simonplourde.pro@gmail.com" class="btn btn-primary">Get in touch</a>
        <a href="https://github.com/simon-plourde" class="btn btn-secondary" target="_blank">GitHub</a>
      </div>
    </section>

    <section class="resume-section">
      <h2>Experience</h2>
      <div class="resume-item">
        <div class="resume-item-header">
          <span class="resume-item-title">Job Title</span>
          <span class="resume-item-date">2023 – Present</span>
        </div>
        <div class="resume-item-org">Company Name</div>
        <div class="resume-item-desc">Brief description of what you did and what impact you had.</div>
      </div>
      <div class="resume-item">
        <div class="resume-item-header">
          <span class="resume-item-title">Previous Job Title</span>
          <span class="resume-item-date">2020 – 2023</span>
        </div>
        <div class="resume-item-org">Previous Company</div>
        <div class="resume-item-desc">Brief description of responsibilities and achievements.</div>
      </div>
    </section>

    <section class="resume-section">
      <h2>Education</h2>
      <div class="resume-item">
        <div class="resume-item-header">
          <span class="resume-item-title">Degree / Program</span>
          <span class="resume-item-date">2016 – 2020</span>
        </div>
        <div class="resume-item-org">University / School Name</div>
      </div>
    </section>

    <section class="resume-section">
      <h2>Skills</h2>
      <div class="skills-grid">
        <span class="skill-tag">Skill 1</span>
        <span class="skill-tag">Skill 2</span>
        <span class="skill-tag">Skill 3</span>
        <span class="skill-tag">Skill 4</span>
        <span class="skill-tag">Skill 5</span>
      </div>
    </section>

  </div>
</Layout>
